# /etc/costura/<marca>.env (modo 600). A marca é definida no build; aqui ficam só variáveis de execução.
APP_ENV=production
SITE_URL=https://loja.example.com
PORT=3000
HOSTNAME=127.0.0.1
COMMERCE_PROVIDER=demo
# Provedor real (ver docs/COMMERCE.md):
# COMMERCE_PROVIDER=shopify
# SHOPIFY_STORE_DOMAIN=minha-loja.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# Só com provedor real e domínio definitivo:
# ALLOW_INDEXING=true
